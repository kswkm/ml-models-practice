# ============================================================================
# .gitignore for Machine Learning Project
# GitHub에 올리지 않을 파일들을 지정합니다
# 
# 📌 목적: 불필요한 파일, 개인정보, 큰 파일들을 저장소에서 제외
# ============================================================================

# ─────────────────────────────────────────────────────────────────────────
# 🐍 Python 관련 (필수)
# ─────────────────────────────────────────────────────────────────────────

# 바이트 컴파일 파일들
# Python이 자동 생성하는 캐시 폴더
__pycache__/
# .pyc, .pyo, .pyd 파일
*.py[cod]
# 클래스 바이트 컴파일 파일
*$py.class

# C 확장 모듈
# 공유 라이브러리 파일
*.so

# 패키지 빌드 파일
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─────────────────────────────────────────────────────────────────────────
# 🔧 Virtual Environment (가상환경)
# ─────────────────────────────────────────────────────────────────────────

# Python 가상환경
venv/
ENV/
env/
.venv
env.bak/
venv.bak/
.env.venv

# Conda 환경 (선택)
# conda-env/
# conda-env/

# ─────────────────────────────────────────────────────────────────────────
# 📓 Jupyter Notebook 캐시
# ─────────────────────────────────────────────────────────────────────────

# Jupyter 자동 저장 폴더
.ipynb_checkpoints/
# 체크포인트 파일
*.ipynb_checkpoints
# Jupyter 설정 폴더
.jupyter/

# ─────────────────────────────────────────────────────────────────────────
# 💻 IDE & 에디터 설정 (VS Code, PyCharm 등)
# ─────────────────────────────────────────────────────────────────────────

# VS Code
# VS Code 설정
.vscode/
*.code-workspace

# PyCharm / IntelliJ
# IDE 설정
.idea/
# IntelliJ 프로젝트 파일
*.iml
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
# Vim 스왑 파일
*.swp
*.swo

# Emacs
*~
.#*

# ─────────────────────────────────────────────────────────────────────────
# 🏋️ 머신러닝 모델 파일 (용량이 크므로 제외)
# ─────────────────────────────────────────────────────────────────────────

# Pickle & Serialized Models
# Python Pickle 파일
*.pkl
*.pickle
*.joblib

# Deep Learning Models
# Keras 모델 파일
*.h5
*.hdf5
# PyTorch 모델
*.pt
*.pth
# ONNX 모델
*.onnx

# TensorFlow
# TensorFlow SavedModel
*.pb
checkpoint/
saved_models/

# ─────────────────────────────────────────────────────────────────────────
# 📊 데이터 파일 (선택사항 - 필요시 주석 제거)
# ─────────────────────────────────────────────────────────────────────────

# 원본 데이터 (용량 크면 제외)
# data/raw/
# data/raw/**/*.csv
# data/raw/**/*.xlsx
# data/raw/**/*.json

# 처리된 데이터 (용량 크면 제외)
# data/processed/
# data/processed/**/*.csv

# 📌 참고: 데이터를 꼭 올려야 하면 .gitignore에서 해당 줄을 주석 처리

# ─────────────────────────────────────────────────────────────────────────
# 📈 결과 및 로그 파일
# ─────────────────────────────────────────────────────────────────────────

# 모델 학습 결과
results/
outputs/
predictions/

# 로그 파일
logs/
# 모든 로그 파일
*.log

# Weights & Biases (실험 추적)
wandb/
.wandb/

# TensorBoard
runs/
.tensorboard/

# ─────────────────────────────────────────────────────────────────────────
# 🔐 환경 변수 및 개인정보
# ─────────────────────────────────────────────────────────────────────────

# 환경 변수 (API 키, 비밀번호 등)
.env
# 로컬 환경 변수
.env.local
.env.*.local
.env.development
.env.production

# 설정 파일 (개인정보 포함 가능)
config.json
config.yaml
secrets/

# ─────────────────────────────────────────────────────────────────────────
# 🖥️ 운영체제 관련 파일
# ─────────────────────────────────────────────────────────────────────────

# macOS
# Mac 폴더 정보
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
# Mac 임시 파일
._*

# Windows
# Windows 휴지통
$RECYCLE.BIN/
# 썸네일 캐시
ehthumbs.db
Thumbs.db
Desktop.ini

# Linux
.directory

# ─────────────────────────────────────────────────────────────────────────
# 🧪 테스트 및 커버리지
# ─────────────────────────────────────────────────────────────────────────

# pytest
.pytest_cache/
# 코드 커버리지
.coverage
# HTML 커버리지 리포트
htmlcov/
.tox/

# unittest
.nose/
.coverage.*

# ─────────────────────────────────────────────────────────────────────────
# 📁 임시 파일
# ─────────────────────────────────────────────────────────────────────────

*.tmp
*.temp
# 백업 파일
*.bak
*.backup
*.orig

# 아카이브 파일 (선택)
# *.zip
# *.tar.gz
# *.rar

# ─────────────────────────────────────────────────────────────────────────
# 📦 패키지 매니저
# ─────────────────────────────────────────────────────────────────────────

# pip
pip-log.txt
pip-delete-this-directory.txt

# Poetry
poetry.lock

# pipenv
Pipfile.lock

# ─────────────────────────────────────────────────────────────────────────
# 🔍 기타
# ─────────────────────────────────────────────────────────────────────────

# 운영 체제 임시 파일
.~lock.*
*.lock

# OS별 선호 파일
.DS_Store
# 예제 파일은 저장 (제외 대상에서 다시 포함)
!.env.example

# ============================================================================
# 📌 주의사항
# ============================================================================
#
# 1. .gitignore 수정 후 기존 파일을 제외하려면:
#    git rm --cached <filename>
#    git commit -m "Remove cached files"
#
# 2. 모든 파일을 정리하려면:
#    git rm --cached -r .
#    git add .
#    git commit -m "Re-add files excluding .gitignore"
#
# 3. .gitignore 무시하고 강제로 추가하려면:
#    git add -f <filename>
#
# ============================================================================